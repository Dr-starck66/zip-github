{
  "name":"ASTRA CONNECTOR GUARD Ω",
  "version":1,
  "states":["PASS","PARTIAL","FAIL","UNVERIFIED"],
  "rules":{
    "authProbeRequired":true,
    "scopeProbeBeforeCriticalAction":true,
    "postActionVerificationRequired":true,
    "neverPassOnAuthFailure":true,
    "neverPassOnUnverifiedMutation":true,
    "retryTransientOnly":true,
    "maxTransientRetries":2,
    "resumeKnownContext":true,
    "preferCloudFallbacks":true,
    "neverLogSecrets":true,
    "manualReauthOnlyWhenProviderRequiresIt":true
  }
}