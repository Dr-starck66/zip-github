        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuditInput"}}}},
        "responses":{"200":{"description":"Audit report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuditReport"}}}}}
