{
  "schema": "astra-brick-registry/v1",
  "version": "1.4.0",
  "policy": {
    "safeByDefault": true,
    "blockOnDrift": true,
    "backupBeforeMutation": true,
    "verifyAfterApply": true,
    "rollbackCapable": true,
    "noCrossRepoWriteWithoutTargetAuthorization": true,
    "futureNodeWebDefaultProfile": "image-ready-node-web-v1"
  },
  "bricks": {
    "stream-resilience-guard": {
      "version": "1.0.0",
      "status": "PROVEN",
      "path": "astra-bricks/stream-resilience-guard",
      "manifest": "astra-bricks/stream-resilience-guard/brick.json",
      "compatibility": {
        "runtime": "node",
        "minNode": "20",
        "requiresPackageJson": true
      },
      "proofRuns": [
        36936238046,
        36938023994,
        36940408363
      ]
    },
    "launch-video": {
      "version": "1.1.0",
      "status": "PROVEN",
      "path": "astra-bricks/launch-video",
      "manifest": "astra-bricks/launch-video/brick.json",
      "compatibility": {
        "runtime": "node",
        "minNode": "22",
        "requiresPackageJson": true,
        "systemDependencies": [
          "ffmpeg",
          "ffprobe"
        ],
        "optionalDependencies": [
          "playwright for automatic live-site capture"
        ]
      },
      "proofRuns": [
        37077054138,
        37077093105,
        37078011216
      ]
    },
    "deploy-trigger-firewall": {
      "version": null,
      "status": "UNMANAGED",
      "path": "astra-bricks/deploy-trigger-firewall",
      "reason": "Legacy reusable brick exists but has no astra-brick/v1 manifest yet."
    },
    "image-seo-rights-guard": {
      "version": "1.0.0",
      "status": "PROVEN",
      "path": "astra-bricks/image-seo-rights-guard",
      "manifest": "astra-bricks/image-seo-rights-guard/brick.json",
      "compatibility": {
        "runtime": "node",
        "minNode": "20",
        "requiresPackageJson": true
      },
      "proofRuns": [
        38255071642,
        38255278442
      ]
    },
    "content-quality-guard": {
      "version": "1.0.0",
      "status": "PROVEN",
      "path": "astra-bricks/content-quality-guard",
      "manifest": "astra-bricks/content-quality-guard/brick.json",
      "compatibility": {
        "runtime": "node",
        "minNode": "20",
        "requiresPackageJson": true
      },
      "proofRuns": []
    }
  },
  "profiles": {
    "baseline-node-web-v1": {
      "description": "Legacy baseline resilience layer for existing Node-based ASTRA web projects.",
      "bricks": [
        "stream-resilience-guard"
      ]
    },
    "launch-video-global-v1": {
      "description": "Global ASTRA LAUNCH VIDEO Ω rollout for any Node project with a demonstrable product surface.",
      "bricks": [
        "launch-video"
      ]
    },
    "launch-ready-node-web-v1": {
      "description": "Default profile for future Node web projects: resilience plus proven launch-video generation.",
      "bricks": [
        "stream-resilience-guard",
        "launch-video"
      ]
    },
    "betgpt-v1": {
      "description": "Current managed BetGPT brick profile.",
      "bricks": [
        "stream-resilience-guard"
      ]
    },
    "image-ready-node-web-v1": {
      "description": "Mandatory images in future Node web launches: resilience, launch video, exact subject-matched licensed SEO image and real file proof; gate requires explicit page inventory.",
      "bricks": [
        "stream-resilience-guard",
        "launch-video",
        "image-seo-rights-guard",
        "content-quality-guard"
      ]
    },
    "content-quality-node-web-v1": {
      "description": "Mandatory standalone content quality gate for Node web sites; blocks filler before publication and audits legacy content without mass noindex.",
      "bricks": [
        "content-quality-guard"
      ]
    }
  }
}
