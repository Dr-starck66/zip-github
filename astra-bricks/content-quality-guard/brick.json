{
  "schema": "astra-brick/v1",
  "id": "content-quality-guard",
  "name": "ASTRA CONTENT QUALITY GUARD Ω",
  "version": "1.0.0",
  "status": "PROVEN",
  "canonicalRepo": "Dr-starck66/zip-github",
  "canonicalPath": "astra-bricks/content-quality-guard",
  "installTargets": {
    "quality.mjs": "scripts/lib/astra-content-quality.mjs",
    "audit.mjs": "scripts/astra-content-quality-audit.mjs"
  },
  "requiredScripts": {
    "guard:content": "node scripts/astra-content-quality-audit.mjs"
  },
  "requiredGateCommand": "npm run guard:content",
  "guarantees": [
    "Reject reusable SEO/editorial padding in new and edited content",
    "Reject identical cross-page paragraphs and heavily reused template section headings",
    "Require actual evidence-to-claim references and a named editorial reviewer",
    "Demand complete public route inventory with no missing new content",
    "Report unmodified legacy corpus as backlog, without mass noindex or silent rewrites",
    "Fail closed on missing manifests or required source/review metadata"
  ],
  "compatibility": {
    "runtime": "node",
    "minNode": "20",
    "requiresPackageJson": true
  },
  "proofRuns": [],
  "injector": {
    "minVersion": "1.0.0",
    "commands": {
      "plan": "node astra-bricks/injector/astra-brick-injector.mjs plan --brick astra-bricks/content-quality-guard --target <project>",
      "apply": "node astra-bricks/injector/astra-brick-injector.mjs apply --brick astra-bricks/content-quality-guard --target <project>",
      "verify": "node astra-bricks/injector/astra-brick-injector.mjs verify --brick astra-bricks/content-quality-guard --target <project>",
      "rollback": "node astra-bricks/injector/astra-brick-injector.mjs rollback --brick astra-bricks/content-quality-guard --target <project>"
    }
  }
}
